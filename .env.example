# Copie este arquivo para .env e preencha com os seus valores reais.
# O arquivo .env NÃO deve ser enviado ao repositório.

# Chave da API da OpenWeather (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=sua_chave_openweather_aqui

# Token do bot gerado pelo @BotFather (cadastrado na credencial "Telegram API" do N8N)
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui

# URL pública HTTPS que aponta para o N8N local (ex.: gerada pelo ngrok)
WEBHOOK_URL=https://seu-subdominio.ngrok-free.app/
