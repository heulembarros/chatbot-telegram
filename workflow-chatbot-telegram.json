{
  "name": "Chatbot Telegram - Clima (OpenWeather)",
  "nodes": [
    {
      "id": "7c7d28b9-ff71-40bc-8c10-c6948dc318c7",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "webhookId": "8ddc213d-1f05-4022-8bda-f426eb29146f",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "3a35e987-5023-459e-9c12-4300c36daa30",
      "name": "Formatar entrada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1d2551a0-3623-4481-967e-c42b3c49d8b7",
              "name": "queue",
              "value": "={{ ($json.message?.text ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim().replace(/\\s+-\\s+/g, ',').replace(/\\s*,\\s*/g, ',').replace(/\\s+/g, ' ').replace(/,br$/, '') + ',br' }}",
              "type": "string"
            },
            {
              "id": "511dfce9-1e43-4a94-92ac-f0f4b092b59b",
              "name": "chatId",
              "value": "={{ $json.message.chat.id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "bb12526e-eeac-43cc-bd79-156a70438980",
      "name": "Consultar OpenWeather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "lang",
              "value": "pt_br"
            },
            {
              "name": "appid",
              "value": "={{ $env.OPENWEATHER_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "8c310808-cd1a-4e96-a543-62734d875222",
      "name": "Resposta válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f1d3892e-5db5-41e9-ae76-34c73d150739",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "f2e03ca4-5950-436c-974f-860ab8c12c68",
              "leftValue": "={{ $json.body?.main?.temp }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "5224a58a-adfa-455a-b00e-e5082c3bb6f4",
              "leftValue": "={{ $json.body?.name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7843c465-50e4-4975-b4c0-4fc5ea9db6d5",
      "name": "Formatar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "jsCode": "// Extrai a temperatura do JSON da OpenWeather e monta a mensagem final\nconst body = $input.first().json.body;\nconst cidade = body.name;\nconst temperatura = Math.round(body.main.temp);\n\nreturn [{\n  json: {\n    chatId: $('Formatar entrada').first().json.chatId,\n    cidade,\n    temperatura,\n    message: `🌤️ A temperatura em ${cidade} é de ${temperatura}°C.`,\n  },\n}];"
      }
    },
    {
      "id": "932f905b-6277-4ec8-8b1b-15403e14658e",
      "name": "Enviar temperatura",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        -100
      ],
      "webhookId": "69fe2827-3da7-4efc-a20f-4affa34b86ad",
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "eca020e9-7f0e-4da3-b799-0f2f9ae8f655",
      "name": "Enviar erro",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        100
      ],
      "webhookId": "5ab74eb0-f713-4fcf-a271-31b98fcaaafd",
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Formatar entrada').first().json.chatId }}",
        "text": "❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ],
